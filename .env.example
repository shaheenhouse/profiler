# NextAuth.js
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-key-here-generate-with-openssl

# Google OAuth (get from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ========================================
# STORAGE CONFIGURATION
# ========================================

# Data directory (only used for local development - defaults to ./data)
# DATA_DIR=/path/to/persistent/data

# ========================================
# VERCEL BLOB STORAGE (Required for Production on Vercel)
# ========================================
# Get this from: Vercel Dashboard > Storage > Create Blob Store
# The token enables persistent storage on Vercel's serverless infrastructure
# Without this, data will be lost between deployments/function invocations
#
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx
